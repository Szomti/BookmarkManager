        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tags_table\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"label\" TEXT NOT NULL, \"border_color\" INTEGER NOT NULL, \"background_color\" INTEGER NOT NULL, \"foreground_color\" INTEGER NOT NULL);"
        }
      ]
    },
