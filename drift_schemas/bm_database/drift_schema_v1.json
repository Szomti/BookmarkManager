      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_tags_table\" (\"book_id\" INTEGER NOT NULL REFERENCES books_table (id) ON DELETE CASCADE, \"tag_id\" INTEGER NOT NULL REFERENCES tags_table (id) ON DELETE CASCADE, PRIMARY KEY (\"book_id\", \"tag_id\"));"
